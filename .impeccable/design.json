  "narrative": {
    "northStar": "The Line of the Month",
    "overview": "Finance Tracker borrows the Athens Metro's wayfinding: a deep navy rail that tells you where you are, a calm tiled ground, and coloured lines that carry meaning. Money moves on lines. Every dated item of the month is a station on its day, hollow while it is only expected and filled once it is received or paid, so the most important distinction in the product (expected is not received) is drawn, not just written.\n\nThe surface is an operating tool used in the evening on a phone and on the 1st of the month at a desk. Density is moderate, hierarchy comes from the size and weight of one typeface, and colour is never decoration: the rail owns the shell, the line colours own the data, and one action blue owns what can be pressed.",
    "keyCharacteristics": [
      "Navy rail shell (desktop sidebar, phone bottom bar) on a cool tile ground with white panels.",
      "Stations: hollow = expected, filled = done, pill with a count = an interchange day.",
      "One family (Source Sans 3), tabular figures for every amount, true minus sign.",
      "One-pixel rules separate sections; no cards, no shadows on content.",
      "Light and dark are both first-class; the device decides unless the user picks."
    ],
    "rules": [
      {
        "name": "The One Meaning Rule",
        "body": "Each line colour means one thing everywhere (green income, red spending, ochre goals, violet tax). Warning amber and danger red always come with an icon and words.",
        "section": "colors"
      },
      {
        "name": "The Zero Is Neutral Rule",
        "body": "An amount of zero is shown in ink, not in its line colour.",
        "section": "colors"
      },
      {
        "name": "The Even Columns Rule",
        "body": "Every amount uses tabular figures (tnum) and a true minus sign (U+2212); a test asserts equal digit widths so a font change cannot break it.",
        "section": "typography"
      },
      {
        "name": "The One Family Rule",
        "body": "Hierarchy comes from size and weight of one family; no display face, no monospace costume.",
        "section": "typography"
      },
      {
        "name": "The Flat Ground Rule",
        "body": "Content never casts a shadow; only overlays do.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do draw expected versus done as hollow versus filled, with words next to it.",
      "Do keep every interactive target at least 44px tall on phones.",
      "Do separate sections with one-pixel rules and space, not boxes.",
      "Do set amounts with tabular figures and a lighter currency symbol."
    ],
    "donts": [
      "Don't use a line colour for anything but its meaning.",
      "Don't put content in cards or nested cards, or add shadows to content.",
      "Don't add eyebrow labels above headings, gradient text or decorative glass.",
      "Don't colour a zero amount."
    ]
  }
}