{
  "name": "finance-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Private, self-hosted personal finance PWA (Next.js + MongoDB), reachable only through Tailscale.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build && node scripts/build-sw.mjs && node scripts/build-scripts.mjs && node scripts/prepare-standalone.mjs",
    "start": "NEXT_TELEMETRY_DISABLED=1 node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "vapid:generate": "node scripts/generate-vapid-keys.mjs",
    "screenshots": "sh scripts/screenshots.sh",
    "test:backup": "sh scripts/test-backup.sh",
    "test:deploy": "bash scripts/test-deploy.sh"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@node-rs/argon2": "2.2.2",
    "date-fns": "4.4.0",
    "lucide-react": "1.61.0",
    "mongodb": "7.7.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "otpauth": "9.5.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "use-intl": "4.14.9",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
