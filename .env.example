# Finance Tracker environment variables.
# Copy to .env and fill in. Never commit .env.
#
# [generated] = random secret. Generate with: openssl rand -hex 32
#               VAPID keys: run the VAPID key script (scripts/, added in Phase 1).
# [you]       = must come from you (third-party dashboard or your own choice).
# Empty optional values disable the feature that needs them.
#
# Do not change generated secrets after the first start:
# - MONGO_* passwords are stored in the database volume on first init.
# - Changing VAPID keys breaks existing push subscriptions.
# - Without RESTIC_PASSWORD, backups cannot be restored. Keep a copy outside the server.
# Keep comments on their own lines: deploy scripts may source this file.

# --- Compose and image ---
COMPOSE_PROJECT_NAME=finance
IMAGE_NAME=ghcr.io/<github-user>/finance_tracker
# "local" builds the image locally. On the server: an immutable tag such as sha-abc1234.
IMAGE_TAG=local
# Host port for the app. Compose always binds it to 127.0.0.1, never 0.0.0.0.
APP_HOST_PORT=3000

# --- App ---
# Local: http://localhost:3000. On the server: https://<your-magicdns-name>
APP_URL=http://localhost:3000
# [generated]
SESSION_SECRET=
# [generated] Encrypts TOTP secrets at rest (32 bytes, hex).
DATA_ENCRYPTION_KEY=
LOG_LEVEL=info

# --- MongoDB (no published port; reachable only inside the Compose network) ---
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=finance
MONGO_ROOT_USER=root
# [generated]
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=finance_app
# [generated]
MONGO_APP_PASSWORD=

# --- Web Push (VAPID) ---
# [generated]
VAPID_PUBLIC_KEY=
# [generated]
VAPID_PRIVATE_KEY=
# [you] Contact for push services: mailto:you@example.com or an https URL.
VAPID_SUBJECT=

# --- Backups (restic, client-side encrypted) ---
# Target: local | s3 | sftp
BACKUP_TARGET=local
BACKUP_LOCAL_DIR=/backups/restic
# Cron expression, evaluated in Europe/Athens.
BACKUP_SCHEDULE="30 3 * * *"
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# restic --host value. Keep it stable, so snapshot groups never split.
BACKUP_HOST=finance-tracker
# Folder inside the R2 bucket, or under SFTP_PATH.
BACKUP_REPO_PREFIX=restic
# A backup run is stopped after this many minutes and recorded as failed.
BACKUP_TIMEOUT_MINUTES=30
# Health check and failure alert when there is no successful backup for this many hours.
BACKUP_STALE_HOURS=26
# [generated]
RESTIC_PASSWORD=

# s3 target: Cloudflare R2. The bucket MUST be private: no public custom domain, no r2.dev access.
# Use an API token scoped to this single bucket with Object Read & Write only.
# [you] https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# [you]
R2_BUCKET=
# [you]
R2_ACCESS_KEY_ID=
# [you]
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# sftp target: Hetzner Storage Box (optional).
SFTP_HOST=
SFTP_PORT=23
SFTP_USER=
SFTP_PATH=
SFTP_KEY_FILE=
# Pinned host key for the Storage Box (required for sftp), e.g. from: ssh-keyscan -p 23 <host>
SFTP_KNOWN_HOSTS_FILE=

# --- Market data (Investing module only; free tiers only; all optional) ---
# [you] Keys from each provider's free plan. Empty = provider skipped, mocks or manual prices used.
TWELVEDATA_API_KEY=
EODHD_API_KEY=
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
# Keyless FX rates (ECB-based).
FX_BASE_URL=https://api.frankfurter.dev
